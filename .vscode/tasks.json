{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "telemetry-api: npm install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "telemetry-api: npm clean",
      "type": "shell",
      "command": "node -e \"const fs=require('fs'); fs.rmSync('${workspaceFolder}/backend/dist', { recursive: true, force: true });\"",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": [
        "telemetry-api: npm install"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "telemetry-api: npm watch",
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": [
        "telemetry-api: npm clean"
      ],
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "telemetry-api: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": [
        "telemetry-api: npm watch"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "telemetry-api",
        "severity": "info",
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Debugger listening on ws://127.0.0.1:9229.*$",
          "endsPattern": "^Telemetry API listening on http://localhost:3000$"
        }
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "desktop-dashboard: npm install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/apps/desktop"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "desktop-dashboard: dev",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/apps/desktop"
      },
      "dependsOn": [
        "desktop-dashboard: npm install"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "desktop-dashboard",
        "severity": "info",
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*Compiling.*$",
          "endsPattern": "^\\s*Compiled successfully.*$"
        }
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "debug: start services",
      "dependsOn": [
        "telemetry-api: dev",
        "desktop-dashboard: dev"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    }
  ]
}
